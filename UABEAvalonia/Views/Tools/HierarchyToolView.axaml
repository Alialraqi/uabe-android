<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UABEAvalonia.ViewModels.Tools"
             xmlns:hier="clr-namespace:UABEAvalonia.Logic.Hierarchy"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="UABEAvalonia.Views.Tools.HierarchyToolView"
             x:DataType="vm:HierarchyToolViewModel">
    <!--
      Hierarchy Tool window view. Top search box, middle TreeView recursively showing the GameObject hierarchy,
      bottom sort checkbox. SelectedItem is two-way bound back to the ViewModel; on selection change the VM collects
      component and sends AssetsSelectedMessage. Double-clicking a node toggles expand/collapse.
    -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top search box -->
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText}"
                 Watermark="Search..."
                 Margin="4" />

        <!-- Hierarchy tree -->
        <TreeView Grid.Row="1"
                  Name="GameObjectTreeView"
                  ItemsSource="{Binding RootItems}"
                  SelectedItem="{Binding SelectedItem}"
                  DoubleTapped="HierarchyTreeView_OnDoubleTapped"
                  BorderThickness="0">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type hier:HierarchyItem}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="hier:HierarchyItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                </Style>
            </TreeView.Styles>
        </TreeView>

        <!-- Bottom sort checkbox -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <CheckBox IsChecked="{Binding SortAlphabetically}"
                      IsEnabled="{Binding !IsLoadingNewItems}"
                      FontSize="11">
                Sort root GameObjects alphabetically
            </CheckBox>
        </Border>

    </Grid>
</UserControl>

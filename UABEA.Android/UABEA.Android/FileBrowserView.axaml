<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UABEA.Android.FileBrowserView">
    <!--
      Built-in file picker: avoids calling the system StorageProvider, which causes the app to go to background and be reclaimed.
      Traverses storage directories directly via System.IO, supporting directory navigation, filtering and selection.
      Three modes supported: Open (pick a file), Save (pick a directory + enter file name), Directory (pick a directory).
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="4">
        <!-- Title bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Name="titleText" Text="Select file" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Name="btnCancel" Content="Cancel" Height="36" MinWidth="70"/>
        </Grid>

        <!-- Path bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
            <Button Grid.Column="0" Name="btnUp" Content="Up" Height="36" MinWidth="60" FontSize="12"/>
            <TextBox Grid.Column="1" Name="pathBox" IsReadOnly="True" FontSize="11" Margin="4,0" Watermark="Current path"/>
            <Button Grid.Column="2" Name="btnHome" Content="Home" Height="36" MinWidth="60" FontSize="12" Margin="2,0,0,0"/>
            <Button Grid.Column="3" Name="btnRefresh" Content="Refresh" Height="36" MinWidth="60" FontSize="12" Margin="2,0,0,0"/>
        </Grid>

        <!-- File name input bar (visible only in Save mode) -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4" Name="saveNamePanel" IsVisible="False">
            <TextBlock Grid.Column="0" Text="File name:" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Name="fileNameBox" FontSize="13" Watermark="Enter file name"/>
            <TextBlock Grid.Column="2" Name="currentDirHint" FontSize="10" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="False"/>
        </Grid>

        <!-- File list -->
        <ListBox Grid.Row="3" Name="fileList" FontSize="13">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
                        <TextBlock Text="{Binding Icon}" FontSize="16" Width="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Button Name="btnConfirm" Content="Select this file" Height="40" MinWidth="120" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</UserControl>

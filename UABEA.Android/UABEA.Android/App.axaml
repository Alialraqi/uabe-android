<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UABEA.Android.App">
  <Application.Resources>
    <!--
      P3-A Android adaptation: register the theme resource dictionary so Avalonia switches automatically when RequestedThemeVariant
      changes SimpleLight/SimpleDark. Android Themes are also available in single-view mode.
      Resources come from the shared UABEAvalonia/Themes/Accents/ (UABEA.Android.csproj linked axaml).
    -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude Source="/UABEAvalonia/Themes/Accents/SimpleLight.axaml" x:Key="Light" />
        <ResourceInclude Source="/UABEAvalonia/Themes/Accents/SimpleDark.axaml" x:Key="Dark" />
        <ResourceInclude Source="/UABEAvalonia/Themes/Accents/SimpleLight.axaml" x:Key="Default" />
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <SimpleTheme/>
  </Application.Styles>
</Application>
